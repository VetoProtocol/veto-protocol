# Copy to .env — .env is gitignored and must never be committed.
# No real values in this file, ever (CLAUDE.md invariant 5).

NODE_ENV=development

# Postgres (Phase 3)
DATABASE_URL=postgres://veto:CHANGEME@localhost:5432/veto_dev

# Redis (Phase 3)
REDIS_URL=redis://localhost:6379

# Permit.io (Phase 5) — server-side only, never exposed to the dashboard bundle.
# The key is environment-scoped: one key per Permit environment (§16). Point this
# at development. Never paste a production key into a developer .env.
PERMIT_API_KEY=
PERMIT_ENV=development

# Hosted PDP. Set to http://localhost:7766 if you run the PDP container instead —
# see docs/permit-setup.md for why that is not an option on this machine.
PERMIT_PDP_URL=https://cloudpdp.api.permit.io

# Optional. Per-request ceiling and how long a fact write waits for the PDP to
# acknowledge it. Defaults are 5000 and 10000; both must be positive integers.
PERMIT_TIMEOUT_MS=
PERMIT_FACTS_SYNC_TIMEOUT_MS=

# Optional override. Routing fact writes through the PDP so it confirms them is
# a LOCAL-PDP-ONLY capability; the hosted PDP answers that endpoint with 404.
# Left unset, this is derived from PERMIT_PDP_URL. Only set it if you know why.
PERMIT_PROXY_FACTS_VIA_PDP=

# Dashboard (Phase 6). The dashboard talks to the control-plane API over HTTP
# like any other client — it never reaches the database directly (invariant 8).
VETO_API_URL=http://localhost:4000

# HMAC key for the session cookie. At least 32 characters; generate with
# `openssl rand -base64 48`. A forged session names its own workspace, so this
# is a tenant boundary, not just a credential.
DASHBOARD_SESSION_SECRET=

# Shared by the dashboard (mints) and the API (verifies). At least 32 chars.
VETO_CAPABILITY_SECRET=

# OIDC sign-in. Any conformant provider; see docs/auth-setup.md for why Google
# is the default recommendation. The redirect URI must match what you registered
# with the provider exactly — scheme, host, port, path.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Local HTTP development only. Never set this where the dashboard is reachable
# over a network — it drops the Secure flag from the session cookie.
DASHBOARD_INSECURE_COOKIES=

# Control plane listener.
API_PORT=4000
API_HOST=127.0.0.1

# Credential vault (Phase 4). Wraps the data keys that encrypt stored provider
# refresh tokens. Generate with `openssl rand -base64 32`.
#
# This is the local stand-in for a KMS: the key sits in the process environment,
# so anything that can read the environment can unwrap every data key. A cloud
# KMS moves that boundary to hardware and is the production posture — see
# docs/threat-model.md T6.
VAULT_MASTER_KEY=

# Google Workspace connection (Phase 4). Drive read-only first; Gmail and
# Calendar are not requested until those integrations exist (spec §9.1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/connections/google/callback

# GitHub App connection. A GitHub *App*, not an OAuth App: `repo` scope is read
# and write across every repository the user can reach and has no read-only
# form, while an App holds only the repositories and permissions the installer
# picked. Leave GITHUB_APP_ID empty to disable GitHub entirely — the routes then
# refuse rather than half-work.
#
# The private key is a PATH, not the key itself. A PEM is multi-line, and a
# multi-line secret in this file is an invitation to paste it with the newlines
# mangled — which fails at JWT signing on the first real call.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=

# The App's user-authorization credentials, from the same settings page.
#
# These are what prove an installation belongs to the person claiming it. The
# post-install redirect carries a `code`; it exchanges for a *user* token, and
# that token's installation list is the only honest answer to "is this yours".
# Without it an installation id is a number anybody can type, and ids are small
# sequential integers.
#
# The App must have **"Request user authorization (OAuth) during installation"**
# switched on, or GitHub sends no code and nothing can be connected. See
# docs/github-setup.md.
#
# API only. The gateway mints installation tokens and takes no part in the
# install round trip, so this secret has no business reaching it.
#
# Leave GITHUB_CLIENT_ID empty and new GitHub connections are refused at the
# start rather than completed on trust. Connections already on file keep
# working — minting a token for one needs the private key and nothing here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Passkeys (Stage 3). The RP id is the registrable domain; origins are exact and
# comma-separated. Both are configuration and never derived from a request — a
# caller that could name its own origin could satisfy the ceremony from a site
# it controls. Leave RP_ID empty to disable passkeys, which also makes approvals
# unresolvable rather than resolvable without proof.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Veto Protocol
WEBAUTHN_ORIGINS=http://localhost:3000

# ── where this deployment is reached from ────────────────────────────────────
# The addresses clients and browsers actually see. Everything below defaults to
# a localhost value, which is why nothing here has to be set in development —
# and why getting them wrong on a real host is invisible until you try it.
#
# GATEWAY_PUBLIC_URL is a BASE, not the endpoint: the gateway publishes
# `${GATEWAY_PUBLIC_URL}/mcp` as the resource in its protected-resource
# metadata, and the Agents > CONNECT snippet is built from the same value.
#
# DASHBOARD_PUBLIC_URL is the OAuth issuer, and is also what every server-side
# redirect is built from. `next start` derives `request.url` from the address it
# is bound to rather than from the Host header, so behind a reverse proxy this
# is the only thing that knows the real origin. Leave it unset locally.
GATEWAY_PUBLIC_URL=http://localhost:4100
GATEWAY_AUTH_SERVER=http://localhost:3000
DASHBOARD_PUBLIC_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

# Where the gateway listens. Loopback; the proxy is what faces the network.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4100

# Optional. Extra scopes on the sign-in request; defaults cover openid/email/profile.
OIDC_SCOPE=

# Optional. `off` stops the in-process webhook delivery loop, for a deployment
# that would rather drive delivery from outside.
WEBHOOK_SCHEDULER=on

# Slack. A bot, never a user token: a bot reads only the conversations it has
# been invited to, which is the grant boundary this integration sells.
#
# Token rotation must be ON for the app, or the install is refused — a classic
# bot token never expires, and storing one in the column that promises a
# rotating credential would be holding one kind of secret while claiming
# another. See docs/slack-setup.md.
#
# Leave SLACK_CLIENT_ID empty to disable Slack entirely; the routes then refuse
# rather than half-work.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/connections/slack/callback


# --- Microsoft 365 -----------------------------------------------------------
# An Entra app registration, multitenant, with a *Web* redirect URI (not SPA —
# an SPA redirect gets a refresh token that dies after 24 hours). Delegated
# Graph permissions only: offline_access, User.Read, Mail.Read, Calendars.Read.
#
# Leave MICROSOFT_CLIENT_ID empty to disable Microsoft entirely; the routes then
# refuse rather than half-working, and connections already on file are
# unaffected.
#
# One thing this provider cannot do: revoke a single refresh token. Microsoft
# offers no such endpoint, so revocation here is local only. See
# docs/microsoft-setup.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/connections/microsoft/callback
