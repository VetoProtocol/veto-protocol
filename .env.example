# Copy to .env — .env is gitignored and must never be committed.
# No real values in this file, ever (CLAUDE.md invariant 5).

NODE_ENV=development

# Postgres (Phase 3)
DATABASE_URL=postgres://veto:CHANGEME@localhost:5432/veto_dev

# Redis (Phase 3)
REDIS_URL=redis://localhost:6379

# Permit.io (Phase 5) — server-side only, never exposed to the dashboard bundle.
# The key is environment-scoped: one key per Permit environment (§16). Point this
# at development. Never paste a production key into a developer .env.
PERMIT_API_KEY=
PERMIT_ENV=development

# Hosted PDP. Set to http://localhost:7766 if you run the PDP container instead —
# see docs/permit-setup.md for why that is not an option on this machine.
PERMIT_PDP_URL=https://cloudpdp.api.permit.io

# Optional. Per-request ceiling and how long a fact write waits for the PDP to
# acknowledge it. Defaults are 5000 and 10000; both must be positive integers.
PERMIT_TIMEOUT_MS=
PERMIT_FACTS_SYNC_TIMEOUT_MS=

# Optional override. Routing fact writes through the PDP so it confirms them is
# a LOCAL-PDP-ONLY capability; the hosted PDP answers that endpoint with 404.
# Left unset, this is derived from PERMIT_PDP_URL. Only set it if you know why.
PERMIT_PROXY_FACTS_VIA_PDP=

# Dashboard (Phase 6). The dashboard talks to the control-plane API over HTTP
# like any other client — it never reaches the database directly (invariant 8).
VETO_API_URL=http://localhost:4000

# HMAC key for the session cookie. At least 32 characters; generate with
# `openssl rand -base64 48`. A forged session names its own workspace, so this
# is a tenant boundary, not just a credential.
DASHBOARD_SESSION_SECRET=

# Shared by the dashboard (mints) and the API (verifies). At least 32 chars.
VETO_CAPABILITY_SECRET=

# OIDC sign-in. Any conformant provider; see docs/auth-setup.md for why Google
# is the default recommendation. The redirect URI must match what you registered
# with the provider exactly — scheme, host, port, path.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback

# Local HTTP development only. Never set this where the dashboard is reachable
# over a network — it drops the Secure flag from the session cookie.
DASHBOARD_INSECURE_COOKIES=

# Control plane listener.
API_PORT=4000
API_HOST=127.0.0.1

# Credential vault (Phase 4). Wraps the data keys that encrypt stored provider
# refresh tokens. Generate with `openssl rand -base64 32`.
#
# This is the local stand-in for a KMS: the key sits in the process environment,
# so anything that can read the environment can unwrap every data key. A cloud
# KMS moves that boundary to hardware and is the production posture — see
# docs/threat-model.md T6.
VAULT_MASTER_KEY=

# Google Workspace connection (Phase 4). Drive read-only first; Gmail and
# Calendar are not requested until those integrations exist (spec §9.1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/connections/google/callback
