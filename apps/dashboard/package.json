{
  "name": "@veto/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' next dev --port 3000",
    "build": "next build",
    "start": "NODE_OPTIONS='--dns-result-order=ipv4first --no-network-family-autoselection' next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@simplewebauthn/browser": "13.2.2",
    "@veto/tokens": "workspace:*",
    "next": "15.1.6",
    "openid-client": "6.8.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "0.0.1",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
