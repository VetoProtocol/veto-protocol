# Veto — production environment.
#
# Copy to .env on the server and fill in. Do NOT build a production environment
# from .env.example: that file is a development template and its PDP URL points
# at the hosted decision point, which is the single most expensive mistake you
# can make here. See PERMIT_PDP_URL below.
#
# chmod 600 and own it by the veto user. It holds every secret the system has.
#
# Every value marked  <<< CHANGE  differs from the development default and will
# break something quietly if you leave it alone.

NODE_ENV=production                                            # <<< CHANGE

# ── data ─────────────────────────────────────────────────────────────────────
# Both local, both on loopback. The veto role OWNS the tables and RLS is FORCEd
# because of it — never grant this role BYPASSRLS and never run the app as a
# superuser, either of which turns tenant isolation off everywhere at once.
DATABASE_URL=postgres://veto:REPLACE_ME@localhost:5432/veto
REDIS_URL=redis://localhost:6379

# ── the decision point ───────────────────────────────────────────────────────
# READ THIS ONE.
#
# The PDP must run on this machine. Hosted was measured at min 211 ms, p50
# ~225 ms, p95 293-739 ms per check — the fastest single check exceeded the
# whole §11 200 ms P95 budget on its own — and roughly one call in four hit the
# 5 s ceiling and failed closed with POLICY_UNAVAILABLE. Local measures p50
# 6.8 ms / p95 8.9 ms, and authorization overhead on a real gateway call went
# from ~1967 ms to ~11 ms.
#
# .env.example still carries https://cloudpdp.api.permit.io. Copying that here
# reverts all of the above.
PERMIT_PDP_URL=http://localhost:7766                           # <<< CHANGE

# A SEPARATE production environment with its own key. Resource-instance keys are
# unique per Permit environment, not per tenant, so sharing an environment with
# development mixes paying customers into your test data.
PERMIT_API_KEY=
PERMIT_ENV=production                                          # <<< CHANGE

# Optional. Per-request ceiling and how long a fact write waits for the PDP to
# acknowledge it. Defaults are 5000 and 10000; both must be positive integers.
PERMIT_TIMEOUT_MS=
PERMIT_FACTS_SYNC_TIMEOUT_MS=

# Optional override, derived from PERMIT_PDP_URL when unset. Routing fact writes
# through the PDP is a local-PDP-only capability. Leave empty.
PERMIT_PROXY_FACTS_VIA_PDP=

# ── secrets ──────────────────────────────────────────────────────────────────
# Generate fresh. Never carry a development secret onto a public box.
#   openssl rand -base64 32
#
# VAULT_MASTER_KEY HAS NO RECOVERY. It wraps the data keys that encrypt every
# stored Google credential. Lose it and every connection becomes unreadable —
# not revoked, unreadable. Back it up off this machine before the first
# credential is stored, and keep it apart from the database dumps: the dump
# without the key is inert, which is the property you want.
#
# It also sits in this process's environment, so anything that can read the
# environment can unwrap every data key. That is an accepted residual risk
# (docs/threat-model.md) and production is meant to swap the KeyWrapper for a
# KMS. Until it does, shell access to this box equals access to every mailbox.
VAULT_MASTER_KEY=
DASHBOARD_SESSION_SECRET=
VETO_CAPABILITY_SECRET=

# ── sign-in (OIDC) ───────────────────────────────────────────────────────────
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://veto.example.com/auth/callback       # <<< CHANGE

# ── connecting Google (Drive / Gmail / Calendar) ─────────────────────────────
# A different client from sign-in, on purpose: separately revocable, and a
# deployment that signs people in without storing a credential is a valid one.
# Google matches redirect_uri exactly, and the API both builds the consent URL
# and exchanges the code, so there is only one copy of this value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://veto.example.com/connections/google/callback   # <<< CHANGE

# ── github app ───────────────────────────────────────────────────────────────
# A GitHub *App*, not an OAuth App: `repo` scope is read and write across every
# repository the user can reach and has no read-only form, while an App holds
# only the repositories and permissions the installer picked.
#
# PRIVATE_KEY_PATH is a path, not the key. A PEM is multi-line, and a multi-line
# secret in this file is an invitation to paste it with the newlines mangled —
# which fails at JWT signing on the first real call, pointing nowhere useful.
# Install it with: install -o veto -g veto -m 400 app.pem /etc/veto/github-app.pem
#
# Leave GITHUB_APP_ID empty to disable GitHub; the routes then refuse plainly.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY_PATH=/etc/veto/github-app.pem

# ── passkeys ─────────────────────────────────────────────────────────────────
# Bound to the domain, cryptographically. A passkey enrolled against one RP_ID
# is worthless against another, and a passkey assertion is the ONLY way to
# resolve a challenge — there is no fallback, deliberately. Get these wrong and
# approvals do not degrade, they stop.
#
# RP_ID is the registrable domain with no scheme and no port. ORIGINS is the
# exact origin, comma separated, with the scheme.
WEBAUTHN_RP_ID=veto.example.com                                # <<< CHANGE
WEBAUTHN_RP_NAME=Veto Protocol
WEBAUTHN_ORIGINS=https://veto.example.com                      # <<< CHANGE

# ── cookies ──────────────────────────────────────────────────────────────────
# MUST be false in production. True drops the Secure attribute, which sends the
# session cookie over plaintext. It exists so localhost development works.
DASHBOARD_INSECURE_COOKIES=false                               # <<< CHANGE

# ── ports and internal addressing ────────────────────────────────────────────
# Stays on loopback. Caddy terminates TLS on this host and proxies to the
# dashboard and the gateway; the control plane is not proxied at all. It manages
# objects, is not an enforcement point, and was never designed to face the
# internet. Do not set 0.0.0.0 without a firewall in front of it.
API_PORT=4000
API_HOST=127.0.0.1
VETO_API_URL=http://localhost:4000

# ── where this deployment is reached from ────────────────────────────────────
# THE SECTION THAT BREAKS A FIRST DEPLOYMENT.
#
# Every one of these defaults to a localhost value, so nothing complains when
# they are missing — the product simply tells clients and browsers to go to
# their own machine. It cannot fail in development, because there the wrong
# answer and the right one are the same string.
#
# An earlier version of this file named VETO_GATEWAY_PUBLIC_URL here, alongside
# VETO_NODE_PATH and VETO_BRIDGE_PATH. No code has ever read any of the three.
#
# GATEWAY_PUBLIC_URL is a BASE, not the endpoint: the gateway publishes
# `${GATEWAY_PUBLIC_URL}/mcp` as the resource in its protected-resource
# metadata, and the Agents > CONNECT snippet is built from the same value. Put
# `/mcp` on the end and clients discover `/mcp/mcp`.
#
# DASHBOARD_PUBLIC_URL is the OAuth issuer AND what every server-side redirect
# is built from. `next start` derives `request.url` from the address it is bound
# to, not from the Host header, so behind a proxy this is the only thing that
# knows the real origin. Unset, sign-out lands on localhost and every OIDC
# sign-in is refused, because the callback URL will not match the redirect URI
# the provider has registered.
GATEWAY_PUBLIC_URL=https://veto.example.com                    # <<< CHANGE
GATEWAY_AUTH_SERVER=https://veto.example.com                   # <<< CHANGE
DASHBOARD_PUBLIC_URL=https://veto.example.com                  # <<< CHANGE
DASHBOARD_URL=https://veto.example.com                         # <<< CHANGE

# Where the gateway listens. Loopback; the proxy faces the network.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4100

# ── optional ─────────────────────────────────────────────────────────────────
# The webhook scheduler runs in-process in every API instance on a five-second
# tick; drainDeliveries claims rows `for update skip locked`, so instances split
# the queue rather than duplicating it. Set to `off` to drive delivery from
# outside instead.
# WEBHOOK_SCHEDULER=on
